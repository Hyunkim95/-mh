FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install curl for healthchecks, build tools for native dependencies, and enable corepack
RUN apk add --no-cache curl python3 make g++ linux-headers libudev-zero-dev && corepack enable

# Copy package files and yarn configuration
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn .yarn
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY libs/ ./libs/

# Install dependencies
RUN yarn install

# Copy source code
COPY . .

# Build shared libraries - only shared needed for web
RUN yarn build:shared

# Expose port
EXPOSE 5173

# Start in development mode with hot reload
CMD ["yarn", "dev:web"]
