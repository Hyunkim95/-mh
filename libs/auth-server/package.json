{
  "name": "@trpc-template/auth-server",
  "version": "1.0.0",
  "description": "Server-side authentication utilities and middleware",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "authentication",
    "auth",
    "server",
    "jwt",
    "trpc",
    "middleware"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@trpc-template/auth-shared": "workspace:*",
    "@libs/ethereum-node": "workspace:*",
    "@libs/solana-node": "workspace:*",
    "@trpc/server": "^10.0.0",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@trpc/server": "^10.0.0",
    "typescript": "^5.0.0"
  }
}