{
  "name": "@libs/ethereum-node",
  "version": "0.1.0",
  "description": "Ethereum services and libraries for backend",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@libs/crypto-utils": "*",
    "drizzle-orm": "^0.29.3",
    "ethers": "^6.8.1",
    "siwe": "^2.1.4"
  },
  "devDependencies": {
    "tsup": "^7.0.0",
    "typescript": "^5.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}
