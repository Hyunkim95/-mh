{
  "name": "@trpc-template/server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "docker exec -it multihopper-postgres psql -U trpc_user -d trpc_db -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public;\"",
    "db:seed": "tsx src/db/seed.ts",
    "db:status": "drizzle-kit up:pg",
    "db:drop": "drizzle-kit drop",
    "db:introspect": "drizzle-kit introspect:pg",
    "db:check": "drizzle-kit check:pg"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.0.0",
    "@libs/crypto-utils": "workspace:*",
    "@libs/solana-node": "workspace:*",
    "@metaplex-foundation/mpl-token-metadata": "^3.2.1",
    "@metaplex-foundation/umi": "^0.9.2",
    "@metaplex-foundation/umi-bundle-defaults": "^0.9.2",
    "@solana/web3.js": "^1.95.4",
    "@trpc/server": "^10.45.2",
    "cron": "^4.3.3",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.20.7",
    "drizzle-orm": "^0.29.3",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.10.9",
    "tsup": "^8.0.2",
    "tsx": "^4.20.5",
    "typescript": "^5.3.3"
  }
}
