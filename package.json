{
  "name": "@trpc-template/root",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "packageManager": "yarn@4.9.4+sha512.7b1cb0b62abba6a537b3a2ce00811a843bea02bcf53138581a6ae5b1bf563f734872bd47de49ce32a9ca9dcaff995aa789577ffb16811da7c603dcf69e73750b",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start --filter=@trpc-template/api",
    "heroku-prebuild": "yarn install --mode=update-lockfile --ignore-engines",
    "heroku-postbuild": "yarn build",
    "dev:web": "turbo run dev --filter=@trpc-template/web",
    "dev:api": "turbo run dev --filter=@trpc-template/api",
    "build:client": "turbo run build --filter=@trpc-template/client",
    "build:server": "turbo run build --filter=@trpc-template/server",
    "build:shared": "turbo run build --filter=@trpc-template/shared",
    "type-check": "turbo run type-check",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build -d",
    "docker:prod": "docker-compose up --build",
    "docker:down": "docker-compose down && docker-compose -f docker-compose.dev.yml down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:dev": "docker-compose -f docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "@types/fastestsmallesttextencoderdecoder": "^1",
    "@types/lodash": "^4.17.20",
    "@types/moment-timezone": "^0.5.30",
    "@types/ws": "^8",
    "turbo": "^2.5.5"
  },
  "dependencies": {
    "@trpc/server": "^10.45.2",
    "bs58": "^6.0.0",
    "cron": "^4.3.3",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "lodash": "^4.17.21",
    "moment-timezone": "^0.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.18.3"
  }
}
