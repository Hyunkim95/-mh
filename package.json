{
  "name": "@trpc-template/root",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start --filter=@trpc-template/api",
    "heroku-postbuild": "yarn build",
    "dev:web": "turbo run dev --filter=@trpc-template/web",
    "dev:api": "turbo run dev --filter=@trpc-template/api",
    "build:client": "turbo run build --filter=@trpc-template/client",
    "build:server": "turbo run build --filter=@trpc-template/server",
    "build:shared": "turbo run build --filter=@trpc-template/shared",
    "type-check": "turbo run type-check",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build -d",
    "docker:prod": "docker-compose up --build",
    "docker:down": "docker-compose down && docker-compose -f docker-compose.dev.yml down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:dev": "docker-compose -f docker-compose.dev.yml logs -f",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "test:e2e:up": "docker compose -f docker-compose.e2e.yml up -d --build",
    "test:e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "test:e2e:logs": "docker compose -f docker-compose.e2e.yml logs -f",
    "test:e2e:browser": "node --no-strip-types node_modules/.bin/playwright test --config e2e-browser/playwright.config.ts",
    "test:e2e:browser:ui": "node --no-strip-types node_modules/.bin/playwright test --config e2e-browser/playwright.config.ts --ui"
  },
  "resolutions": {
    "drizzle-orm": "0.29.5",
    "@types/pg": "8.20.0"
  },
  "dependencies": {
    "drizzle-orm": "0.29.5",
    "papaparse": "^5.5.3",
    "pg": "^8.13.1",
    "turbo": "^2.5.5",
    "vite-plugin-svgr": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@solana/spl-token": "^0.4.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27",
    "@types/lodash": "^4.17.20",
    "@types/node": "^25.0.3",
    "@types/papaparse": "^5.5.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "4.0.16",
    "drizzle-kit": "^0.31.5",
    "jsdom": "^27.4.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.16"
  }
}
